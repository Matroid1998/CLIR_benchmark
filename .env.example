# Copy to .env and fill in. Loaded automatically by the `clir` CLI.

# Question generation (OpenAI Chat Completions)
OPENAI_API_KEY=

# Verification / grading (Claude and others via OpenRouter)
OPENROUTER_API_KEY=

# Legal prompt versioning: account-free MLflow SQLite registry; default .clir/prompts.db.
# Optional absolute override: sqlite:////absolute/path/to/prompts.db
CLIR_PROMPT_REGISTRY_URI=
# Optional explicit run pin; otherwise .clir/active_prompt_manifest.json is used when present.
CLIR_PROMPT_MANIFEST=
# Explicit unregistered offline development/testing only: CLIR_PROMPT_SOURCE=local

# Dataset publishing and loading from the Hugging Face Hub
HF_TOKEN=

# Google Patents extraction via BigQuery. Required by `clir ingest gp`.
# (The old repo required this but never documented it in .env.)
GOOGLE_CLOUD_PROJECT=
