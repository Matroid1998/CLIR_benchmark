# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Heavy data + model caches (never tracked)
data/
.cache/
.clir/
mlruns/
cluster/out/

# Third-party checkouts driven as subprocesses. eur-lex-visualiser is GPL-3.0:
# it is cloned locally and invoked as a CLI, never vendored into this tree.
tools/

# Run artifacts: keep summaries and findings, drop bulk outputs
reports/runs/*/predictions/
reports/runs/*/emb/
reports/**/experimental_plots/
reports/**/experimental_codes/
.pytest_cache/
reports/runs/*/parts/

# Prompt version history stays local; current prompts live under src/.
reports/prompt_versions/
reports/prompt_experiments/*/
reports/**/prompt_manifest.json
reports/**/verifier_prompt_manifest.json
reports/**/before_manifest.json
reports/**/changed_manifest.json
reports/**/registry_prompts.json

# Raw run records include prompt snapshots and can exceed GitHub's size limit.
reports/**/*.sqlite
reports/**/*.sqlite-*
reports/**/llm_calls.json
reports/**/trace.md
reports/**/all_mode_candidates.csv
reports/**/*.log

# Import bundles are local; extracted current templates are tracked under src/.
/EURLEX_ENGLISH_BUNDLE.md
/UN_ENGLISH_BUNDLE.md
/ALL_VERIFIERS*.md
